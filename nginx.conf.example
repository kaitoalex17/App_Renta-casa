# ==============================================================================
# Configuración Nginx para RentaCasa (Detrás de Cloudflare Proxy y Nginx)
# ==============================================================================

# Rangos de IP oficiales de Cloudflare para restaurar la IP real de los clientes
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

# Utilizar la cabecera CF-Connecting-IP provista por Cloudflare
real_ip_header CF-Connecting-IP;

server {
    listen 80;
    server_name tu-dominio-alquiler.com www.tu-dominio-alquiler.com;

    # Si usas SSL en Nginx (o Certbot) descomenta / ajusta los bloques SSL:
    # listen 443 ssl http2;
    # ssl_certificate /etc/letsencrypt/live/tu-dominio-alquiler.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tu-dominio-alquiler.com/privkey.pem;

    # Tamaño máximo para subida de fotos de incidencias, DNI y contratos en PDF
    client_max_body_size 50M;

    location / {
        # Puerto donde corre el contenedor de la app (puerto 3000 por defecto)
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Soporte para WebSockets y Server-Sent Events (SSE)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Trazabilidad de IP para el Audit Trail probatorio de firmas digitales
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;

        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90;
    }
}
