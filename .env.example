# ==============================================================================
# RentaCasa Coliving Platform — Variables de Entorno (.env.example)
# ==============================================================================

# 1. Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# Dentro de la red interna de Docker Compose, el host es 'db' y el puerto interno '5432'.
# Si te conectas desde fuera del contenedor (host), recuerda que el puerto es 5492 (5432 + 60).
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/rentacasa?schema=public

# Variables del servicio de base de datos (PostgreSQL container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=rentacasa

# 2. Seguridad y Autenticación (JWT / Sesiones)
# ------------------------------------------------------------------------------
# Clave criptográfica para firmar las cookies de sesión y tokens de acceso.
# Generar una con: openssl rand -base64 32
NEXTAUTH_SECRET=clave_secreta_super_segura_de_al_menos_32_caracteres_produccion

# 3. URL Pública y Enrutamiento
# ------------------------------------------------------------------------------
# URL pública donde responderá la plataforma (con HTTPS/Cloudflare).
# Se utiliza para generar los enlaces de WhatsApp de firma móvil y portal del inquilino.
NEXTAUTH_URL=https://renta-casa.instala.xyz
NEXT_PUBLIC_APP_URL=https://renta-casa.instala.xyz

# 4. Servidor de Producción Next.js
# ------------------------------------------------------------------------------
# Puerto de ejecución asignado (+60 respecto al estándar 3000 -> 3060)
PORT=3060
NODE_ENV=production
