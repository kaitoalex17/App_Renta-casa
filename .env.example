# Cadena de conexión de PostgreSQL
# En Portainer dentro de la red Docker el host es 'db:5432'.
# Si te conectas desde el host localmente, el puerto mapeado (+60) es 5492:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5492/rentacasa?schema=public"

# Secreto para JWT y tokens de sesión
NEXTAUTH_SECRET="clave_secreta_super_segura_de_al_menos_32_caracteres_cambiar_en_produccion"

# URL base pública del despliegue (puerto +60: 3060)
NEXTAUTH_URL="http://localhost:3060"
NEXT_PUBLIC_APP_URL="http://localhost:3060"

NODE_ENV="development"
